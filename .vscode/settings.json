        "ui.codelenses": {
            "generate": true,
            "test": true,
            "gc_details": true
        }
    },
    "go.toolsManagement.autoUpdate": true,
    "go.delveConfig": {
        "apiVersion": 2,
        "showGlobalVariables": true
    }
}
